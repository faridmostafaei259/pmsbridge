# Example settings for a test installation. Copy this file to deploy/.env, replace every placeholder,
# then run: chmod 600 deploy/.env
# Never commit or share the .env file: it holds your encryption key. All settings are explained in
# docs/configuration.md.

# production requires HTTPS and a public address that matches DOMAIN.
ENVIRONMENT=production

# The host name people use to reach this installation. No https:// and no path.
DOMAIN=mcp.example.com

# The full public address. It must start with https:// and its host must be exactly DOMAIN.
PUBLIC_BASE_URL=https://mcp.example.com

# auto gets a real certificate for DOMAIN. internal is for testing on your own machine only.
TLS_MODE=auto

# An address the certificate authority can contact about your certificate (needed when TLS_MODE=auto).
ACME_EMAIL=you@example.com

# The key that protects stored PMS credentials. Create it once with this command, which adds the
# line to deploy/.env (run it from the folder that contains deploy/), then save that line in a
# password manager:
#   (umask 077; printf 'ENCRYPTION_KEYS=k1:%s\n' "$(openssl rand -base64 32)" >> deploy/.env)
# Do not type a key here by hand and do not add a second ENCRYPTION_KEYS line.
# ENCRYPTION_KEYS=k1:<created by the command above>
